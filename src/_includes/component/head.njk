<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | default("AMP | Digital Marketing Agency - Canada") }}</title>
  <meta name="description" content="{{ description | default("As a strategy‑driven creative studio, AMP helps bold brands clarify their voice, design sites that convert and amplify growth with campaigns that compound.") }}">
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title | default("AMP | Digital Marketing Agency - Canada") }}">
  <meta property="og:description" content="{{ description | default("As a strategy‑driven creative studio, AMP helps bold brands clarify their voice, design sites that convert and amplify growth with campaigns that compound.") }}">
  <meta property="og:image" content="/images/og-image.png">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | default("AMP | Digital Marketing Agency - Canada") }}">
  <meta name="twitter:description" content="{{ description | default("As a strategy‑driven creative studio, AMP helps bold brands clarify their voice, design sites that convert and amplify growth with campaigns that compound.") }}">
  <meta name="twitter:image" content="/images/og-image.png">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/amp-logo.png">
  <link rel="apple-touch-icon" href="/images/amp-logo.png">

  <!-- Fonts: Geist, Inter & Red Hat Mono (Exact match to ampvisualmedia.com) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&family=Red+Hat+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/style.css">

</head>