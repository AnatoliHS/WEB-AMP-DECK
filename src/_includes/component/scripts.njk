<script>
  // FAQ Card Deck
  const faqCards = Array.from(document.querySelectorAll('.faq-card'));
  const faqCount = document.getElementById('faqDeckCount');
  const faqFlipAll = document.getElementById('faqDeckFlipAll');
  const faqReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function isFlipped(card) {
    return card.getAttribute('aria-pressed') === 'true';
  }

  function syncFaqDeck() {
    const flipped = faqCards.filter(isFlipped).length;
    if (faqCount) faqCount.textContent = flipped + ' / ' + faqCards.length + ' flipped';
    if (faqFlipAll) faqFlipAll.textContent = flipped === faqCards.length ? 'Reset deck' : 'Flip all';
  }

  faqCards.forEach(card => {
    card.addEventListener('click', () => {
      card.setAttribute('aria-pressed', isFlipped(card) ? 'false' : 'true');
      syncFaqDeck();
    });
  });

  if (faqFlipAll) {
    faqFlipAll.addEventListener('click', () => {
      const allFlipped = faqCards.every(isFlipped);
      // Stagger the flips so the deck turns over card by card
      faqCards.forEach((card, i) => {
        setTimeout(() => {
          card.setAttribute('aria-pressed', allFlipped ? 'false' : 'true');
          syncFaqDeck();
        }, faqReducedMotion ? 0 : i * 90);
      });
    });
  }

  syncFaqDeck();

  // "Sound familiar?" — deal the cards in when the section comes into view.
  // On phones the cards form a fanned pile: swipe right for the next card, left to bring one back.
  (function initMirrorCards() {
    const section = document.querySelector('.section-mirror');
    const table = section && section.querySelector('[data-mirror-table]');
    if (!table) return;

    const cards = Array.from(table.querySelectorAll('.mirror-card'));
    const count = section.querySelector('[data-mirror-count]');
    const prevBtn = section.querySelector('[data-mirror-prev]');
    const nextBtn = section.querySelector('[data-mirror-next]');
    const phone = window.matchMedia('(max-width: 900px)');
    const SWIPE = 70;
    let index = 0;
    let dealt = false;

    section.classList.add('is-animated');

    function renderPile(stagger) {
      // Nudge the pile left as it grows so the fan stays centred on screen
      const shift = (cards.length - 1 - index) * 4;
      cards.forEach((card, i) => {
        const depth = i - index;
        const away = !dealt || depth < 0;
        card.style.transform = away
          ? 'translate(130vw, -30px) rotate(24deg)'
          : 'translate(' + (depth * 5 - shift) + 'px, ' + depth * 2 + 'px) rotate(' + depth * 3 + 'deg)';
        // Swiped cards sit above the pile so they slide back over it
        card.style.zIndex = depth < 0 ? 20 + i : 10 - depth;
        // Leaving cards get a slower, even curve so the exit is visible
        // (the pile's ease-out would cover the whole distance almost instantly)
        card.style.transition = depth < 0 && dealt ? 'transform 0.65s cubic-bezier(0.45, 0, 0.2, 1)' : '';
        // Bottom card lands first, card 01 lands last on top
        card.style.transitionDelay = stagger ? (cards.length - 1 - i) * 0.12 + 's' : '0s';
        card.classList.toggle('is-top', depth === 0);
      });
      count.textContent = (index + 1) + ' / ' + cards.length;
      prevBtn.disabled = index === 0;
      nextBtn.disabled = index === cards.length - 1;
      if (stagger) setTimeout(() => cards.forEach(c => { c.style.transitionDelay = '0s'; }), 1200);
    }

    function setMode() {
      const pile = phone.matches;
      section.classList.toggle('is-pile', pile);
      if (pile) {
        renderPile(false);
      } else {
        cards.forEach(c => {
          c.style.transform = '';
          c.style.zIndex = '';
          c.style.transitionDelay = '';
          c.classList.remove('is-top');
        });
      }
    }

    function go(step) {
      const next = Math.min(cards.length - 1, Math.max(0, index + step));
      if (next === index) { renderPile(false); return; }
      index = next;
      renderPile(false);
    }

    prevBtn.addEventListener('click', () => go(-1));
    nextBtn.addEventListener('click', () => go(1));

    // Swipe the top card
    let drag = null;
    table.addEventListener('pointerdown', e => {
      if (!section.classList.contains('is-pile') || !dealt) return;
      const top = cards[index];
      if (!top.contains(e.target)) return;
      drag = { card: top, x: e.clientX, dx: 0 };
      top.setPointerCapture(e.pointerId);
      top.classList.add('is-dragging');
    });
    table.addEventListener('pointermove', e => {
      if (!drag) return;
      drag.dx = e.clientX - drag.x;
      drag.card.style.transform = 'translate(' + drag.dx + 'px, 0) rotate(' + drag.dx / 18 + 'deg)';
    });
    function endDrag() {
      if (!drag) return;
      drag.card.classList.remove('is-dragging');
      const dx = drag.dx;
      drag = null;
      if (dx > SWIPE) go(1);
      else if (dx < -SWIPE) go(-1);
      else renderPile(false);
    }
    table.addEventListener('pointerup', endDrag);
    table.addEventListener('pointercancel', endDrag);

    function dealIn() {
      if (dealt) return;
      dealt = true;
      section.classList.add('is-dealt');
      if (section.classList.contains('is-pile')) renderPile(true);
    }

    phone.addEventListener('change', setMode);
    setMode();

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => {
        if (entries.some(en => en.isIntersecting)) { dealIn(); io.disconnect(); }
      }, { threshold: 0.35 });
      io.observe(table);
    } else {
      dealIn();
    }
  })();

  // Page transitions: play a card clip when navigating to key pages.
  // Going to Home plays card-fan; other pages load normally.
  (function initPageTransitions() {
    const overlay = document.querySelector('.page-transition');
    if (!overlay) return;
    const root = document.documentElement;

    // Arriving: reveal the page by fading the dark overlay away
    if (root.classList.contains('is-arriving')) {
      // Hold the logo at navbar size while the overlay fades, then reset it once hidden
      overlay.classList.add('is-done');
      requestAnimationFrame(() => requestAnimationFrame(() => {
        root.classList.remove('is-arriving');
        setTimeout(() => overlay.classList.remove('is-done'), 600);
      }));
    }
    // Back/forward cache restores the page mid-transition; reset it
    window.addEventListener('pageshow', e => {
      if (e.persisted) {
        overlay.classList.remove('is-leaving', 'is-done');
        overlay.querySelectorAll('video').forEach(v => { v.classList.remove('is-playing'); v.pause(); });
      }
    });

    // No transitions on phones and tablets (also skips downloading the clips there)
    const mobile = window.matchMedia('(max-width: 900px), (hover: none) and (pointer: coarse)');
    if (mobile.matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.remove('is-intro');
      return;
    }

    const clips = {
      fan: overlay.querySelector('[data-clip="fan"]')
    };
    // Only these destinations get a transition; every other page loads normally
    const routes = {
      '/': 'fan'
    };
    const normalise = path => (path.replace(/index\.html$/, '').replace(/\/?$/, '/'));

    // Home page intro (desktop, direct load or reload): play card-fan, then reveal the page
    if (root.classList.contains('is-intro')) {
      const intro = clips.fan;
      let revealed = false;
      const reveal = () => {
        if (revealed) return;
        revealed = true;
        overlay.classList.add('is-done');
        // Wait for the logo to finish shrinking onto the navbar before revealing
        setTimeout(() => {
          root.classList.remove('is-intro');
          // Reset the overlay once it has faded so later transitions start clean
          setTimeout(() => {
            overlay.classList.remove('is-done');
            intro.classList.remove('is-playing');
          }, 500);
        }, 480);
      };
      intro.preload = 'auto';
      overlay.dataset.clip = 'fan';
      intro.classList.add('is-playing');
      intro.addEventListener('ended', reveal, { once: true });
      // Never hold the page hostage: reveal anyway if the clip is slow or blocked
      setTimeout(reveal, 3500);
      const started = intro.play();
      if (started && started.catch) started.catch(reveal);
    }

    // Warm up both clips once the page has settled so they start instantly on click
    window.addEventListener('load', () => {
      setTimeout(() => Object.values(clips).forEach(v => { v.preload = 'auto'; v.load(); }), 1200);
    });

    let busy = false;
    document.addEventListener('click', e => {
      if (busy || mobile.matches || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = e.target.closest('a[href]');
      if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
      const url = new URL(link.href, location.href);
      if (url.origin !== location.origin) return;
      const from = normalise(location.pathname);
      const to = normalise(url.pathname);
      if (to === from) return; // same page (including in-page anchors)
      const clip = clips[routes[to]];
      if (!clip) return;

      e.preventDefault();
      busy = true;
      const go = () => {
        try { sessionStorage.setItem('amp-transition', '1'); } catch (err) {}
        location.href = url.href;
      };
      // Fetch the next page while the clip plays
      const hint = document.createElement('link');
      hint.rel = 'prefetch';
      hint.href = url.href;
      document.head.appendChild(hint);

      overlay.classList.remove('is-done');
      overlay.dataset.clip = routes[to]; // lets CSS place the logo per clip
      overlay.classList.add('is-leaving');
      clip.classList.add('is-playing');
      clip.currentTime = 0;

      let finished = false;
      const finish = () => {
        if (finished) return;
        finished = true;
        overlay.classList.add('is-done');
        // Wait for the logo to finish shrinking onto the navbar before leaving
        setTimeout(go, 480);
      };
      clip.addEventListener('ended', finish, { once: true });
      // Safety net in case the clip stalls or never reports "ended"
      setTimeout(finish, ((clip.duration || 2.1) * 1000) + 1500);
      const playing = clip.play();
      if (playing && playing.catch) playing.catch(go);
    });
  })();

  // Header Scroll Effect
  const header = document.querySelector('.site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
  });
</script>